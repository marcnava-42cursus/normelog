#!/usr/bin/env bash
# normelog entrypoint
set -euo pipefail

# Resolve base dir
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
BASE_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# Detect if running from installation or development
if [[ -d "$BASE_DIR/lib/normelog" ]]; then
	# Installed system-wide (e.g., /usr/local/lib/normelog)
	LIB_DIR="$BASE_DIR/lib/normelog"
elif [[ -d "$BASE_DIR/lib" && -f "$BASE_DIR/lib/version.sh" ]]; then
	# Running from source directory
	LIB_DIR="$BASE_DIR/lib"
else
	echo "Error: Cannot find normelog libraries" >&2
	exit 1
fi

# shell environment
. "$LIB_DIR/env.sh"
. "$LIB_DIR/version.sh"
. "$LIB_DIR/log.sh"
. "$LIB_DIR/compat.sh"
. "$LIB_DIR/config.sh"
. "$LIB_DIR/flags.sh"
. "$LIB_DIR/run_norminette.sh"
. "$LIB_DIR/exclude.sh"
. "$LIB_DIR/parse.sh"
. "$LIB_DIR/filter.sh"
. "$LIB_DIR/stats.sh"
. "$LIB_DIR/format_text.sh"
. "$LIB_DIR/format_json.sh"
. "$LIB_DIR/format_html.sh"
. "$LIB_DIR/format_junit.sh"
. "$LIB_DIR/format_sarif.sh"
. "$LIB_DIR/update_check.sh"
. "$LIB_DIR/update_apply.sh"
. "$LIB_DIR/plugins.sh"
. "$LIB_DIR/git.sh"
. "$LIB_DIR/watch.sh"
. "$LIB_DIR/severity.sh"
. "$LIB_DIR/diff.sh"
. "$LIB_DIR/parallel.sh"
. "$LIB_DIR/optimize.sh"

main() {
  nl_env_init
  nl_version_init
  nl_optimize_init
  # Store original args for watch mode
  NL_ORIGINAL_ARGS=("$@")
  # parse flags first to allow --help/--version early exit
  NL_PARSE_MODE="meta" nl_flags_parse "$@"
  # Early exits for meta flags before any other logic
  if [[ "${NL_SHOW_VERSION:-0}" -eq 1 ]]; then
	echo "normelog ${NL_VERSION}"; exit 0
  fi
  if [[ "${NL_DO_UPDATE:-0}" -eq 1 ]]; then
	nl_update_apply
	exit $?
  fi
  if [[ "${NL_WATCH:-0}" -eq 1 ]]; then
	nl_watch_run
	exit $?
  fi
  if [[ "${NL_SHOW_HELP:-0}" -eq 1 ]]; then
	local man_file=""
	for candidate in \
	  "$BASE_DIR/share/man/normelog.1" \
	  "$BASE_DIR/share/man/man1/normelog.1" \
	  "/usr/local/share/man/man1/normelog.1" \
	  "/usr/share/man/man1/normelog.1"; do
	  if [[ -f "$candidate" ]]; then
		man_file="$candidate"
		break
	  fi
	done
	if [[ -n "$man_file" ]]; then
	  if command -v man >/dev/null 2>&1; then
		if ! MANPAGER=cat MANWIDTH="${MANWIDTH:-80}" man -l "$man_file"; then
		  if command -v nroff >/dev/null 2>&1; then
			nroff -man "$man_file" | sed -e 's/.\x08//g'
		  elif command -v groff >/dev/null 2>&1; then
			groff -man -Tutf8 "$man_file" | sed -e 's/.\x08//g'
		  else
			cat "$man_file"
		  fi
		fi
	  elif command -v nroff >/dev/null 2>&1; then
		nroff -man "$man_file" | sed -e 's/.\x08//g'
	  elif command -v groff >/dev/null 2>&1; then
		groff -man -Tutf8 "$man_file" | sed -e 's/.\x08//g'
	  else
		cat "$man_file"
	  fi
	else
	  nl_flags_help
	fi
	exit 0
  fi
  # Change directory if requested
  if [[ -n "${NL_CHDIR:-}" ]]; then
	if ! cd -- "$NL_CHDIR"; then
	  nl_log_error "Failed to change directory to $NL_CHDIR"
	  exit 1
	fi
  fi
  nl_config_load "$@"

  # Re-parse flags so they override config (e.g. NL_ORDER)
  nl_flags_parse "$@"

  # Load plugins
  nl_plugins_load

  # (version/help handled above)

  # Handle git integration modes
  local git_files=()
  if [[ "${NL_GIT_STAGED:-0}" -eq 1 ]]; then
	nl_log_debug "Getting staged files from git..."
	mapfile -t git_files < <(nl_git_get_staged_files)
  elif [[ -n "${NL_GIT_SINCE:-}" ]]; then
	nl_log_debug "Getting files changed since ${NL_GIT_SINCE}..."
	mapfile -t git_files < <(nl_git_get_changed_files "$NL_GIT_SINCE")
  elif [[ -n "${NL_GIT_BRANCH:-}" ]]; then
	nl_log_debug "Getting files changed in current branch vs ${NL_GIT_BRANCH}..."
	mapfile -t git_files < <(nl_git_get_branch_files "$NL_GIT_BRANCH")
  fi

  # If git mode returned files, override NL_DIRS
  if [[ ${#git_files[@]} -gt 0 ]]; then
	nl_log_debug "Found ${#git_files[@]} changed files"
	NL_DIRS=("${git_files[@]}")
  elif [[ "${NL_GIT_STAGED:-0}" -eq 1 ]] || [[ -n "${NL_GIT_SINCE:-}" ]] || [[ -n "${NL_GIT_BRANCH:-}" ]]; then
	nl_log_info "No changed C/H files found"
	exit 0
  fi

  # Call pre-norminette hook
  nl_hook_pre_norminette

  nl_log_debug "Running norminette..."
  local output
  set +e

  # Use parallel execution if requested
  if [[ "${NL_PARALLEL:-0}" -eq 1 ]]; then
	nl_log_debug "Using parallel execution with ${NL_PARALLEL_JOBS} jobs"
	output=$(nl_parallel_run_norminette)
	rc=$?
	if [[ $rc -ne 0 ]]; then
		nl_log_warn "Parallel execution unavailable, falling back to sequential"
		output=$(nl_run_norminette)
		rc=$?
	fi
  else
	output=$(nl_run_norminette)
	rc=$?
  fi

  set -e
  if [[ $rc -eq 127 ]]; then
	nl_log_error "norminette not found in PATH"
	exit 127
  fi

  if [[ -z "$output" ]]; then
	nl_log_error "No C files found or norminette produced no output"
	exit 0
  fi

  nl_log_debug "Applying exclusions..."
  output=$(nl_exclude_filter <<<"$output")

  nl_log_debug "Parsing output..."
  local records
  records=$(nl_parse_output <<<"$output")

  # Call post-parse hook
  nl_hook_post_parse

  nl_log_debug "Filtering by error types..."
  local filtered
  filtered=$(nl_filter_errors <<<"$records")

  # Apply severity filtering if requested
  if [[ -n "${NL_MIN_SEVERITY:-}" ]] || [[ -n "${NL_ONLY_SEVERITY:-}" ]]; then
	if [[ -n "${NL_ONLY_SEVERITY:-}" ]]; then
		nl_log_debug "Filtering by exact severity: ${NL_ONLY_SEVERITY}..."
	else
		nl_log_debug "Filtering by minimum severity: ${NL_MIN_SEVERITY}..."
	fi
	filtered=$(nl_severity_filter <<<"$filtered")
  fi

  nl_log_debug "Computing stats..."
  local stats
  stats=$(nl_compute_stats <<<"$filtered")

  # Compute severity statistics
  local severity_stats
  severity_stats=$(nl_severity_stats <<<"$filtered")

  # Call post-stats hook
  nl_hook_post_stats

  # Call pre-format hook
  nl_hook_pre_format

  # Generate output based on format
  local output_result
  case "${NL_OUTPUT:-text}" in
	json)
		output_result=$(nl_format_json "$filtered" "$stats")
		;;
	html)
		output_result=$(nl_format_html "$filtered" "$stats" "$severity_stats")
		;;
	junit)
		output_result=$(nl_format_junit "$filtered" "$stats")
		;;
	sarif)
		output_result=$(nl_format_sarif "$filtered" "$stats")
		;;
	*)
		output_result=$(nl_format_text "$filtered" "$stats" "$severity_stats")
		;;
  esac

  # Handle diff mode
  if [[ -n "${NL_DIFF_BASELINE:-}" ]]; then
	# For diff mode, we need JSON output
	if [[ "$NL_OUTPUT" != "json" ]]; then
		nl_log_error "Diff mode requires JSON output. Use --json or run: normelog --json > baseline.json"
		exit 1
	fi
	nl_diff_compare "$NL_DIFF_BASELINE" "$output_result"
	exit $?
  fi

  # Handle save-baseline mode
  if [[ -n "${NL_SAVE_BASELINE:-}" ]]; then
	if [[ "$NL_OUTPUT" != "json" ]]; then
		nl_log_error "Save baseline requires JSON output. Use --json with --save-baseline"
		exit 1
	fi
	nl_diff_save_baseline "$NL_SAVE_BASELINE" "$output_result"
  fi

  # Output results
  echo "$output_result"

  # Check for updates (unless disabled)
  if [[ "${NL_NO_UPDATE_CHECK:-0}" -eq 0 ]]; then
	nl_update_check
  fi

  # Exit with error if max-errors threshold exceeded
  if [[ -n "${NL_MAX_ERRORS:-}" ]]; then
	local total_errors
	total_errors=$(echo "$stats" | awk '/^TOTAL_ERRORS/ {print $2}')
	if [[ -n "$total_errors" ]] && [[ $total_errors -gt ${NL_MAX_ERRORS} ]]; then
		nl_log_error "Error threshold exceeded: $total_errors errors (max: ${NL_MAX_ERRORS})"
		exit 1
	fi
  fi
}

main "$@"
